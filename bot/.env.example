# ── Telegram Bot (від BotFather) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # токен від @BotFather (обов'язково)
TELEGRAM_BOT_USERNAME=myjob_in_bot

# ── Bot HTTP API Security ──────────────────────────────────────────────────
# Цей токен використовується для перевірки Authorization: Bearer <token>
# у запитах з Laravel → Bot (має збігатися з Laravel TELEGRAM_BOT_API_TOKEN)
# Генерувати: openssl rand -hex 32
BOT_API_TOKEN=

# ── Laravel Connection ─────────────────────────────────────────────────────
# URL Laravel-додатку всередині Docker-мережі
LARAVEL_API_URL=http://nginx:8080

# Той самий токен, що TELEGRAM_WEBHOOK_TOKEN у Laravel .env
# Використовується в X-Telegram-Webhook-Token header при викликах Bot → Laravel
LARAVEL_WEBHOOK_TOKEN=

# ── Telegram Webhook ───────────────────────────────────────────────────────
# Секрет для шляху /telegram/webhook/{secret} (Telegram надсилає саме сюди)
# Генерувати: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Публічний URL бота (для реєстрації webhook у Telegram)
PUBLIC_URL=https://bot.myjob.co.ua

# ── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=production
